<div class="container">
  <header class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-between py-3 mb-4 border-bottom">
    <div class="col-md-3 mb-2 mb-md-0">
      <a href="/" class="d-inline-flex link-body-emphasis text-decoration-none">
        <%= image_tag "brand/bootstrap-logo.svg", alt: "Logo", width: 30, height: 24, class: "d-inline-block align-text-top" %>
      </a>
    </div>

    <ul class="nav col-12 col-md-auto mb-2 justify-content-center mb-md-0">
      <li><%= link_to "首页", root_path, class: nav_link_class("home") %></li>
      <li><%= link_to "课程", courses_path, class: nav_link_class("courses") %></li>
      <li><%= link_to "用户", users_path, class: nav_link_class("users") %></li>
    </ul>

    <div class="col-md-3 text-end">
      <% if logged_in? %>
        <span class="me-2"><%= current_user.name %></span>
        <%= link_to "修改密码", edit_password_path, class: "btn btn-sm btn-outline-secondary me-2" %>
        <%= button_to "登出", session_path, method: :delete, class: "btn btn-outline-primary", form_class: "d-inline" %>
      <% else %>
        <%= link_to "登录", new_session_path, class: "btn btn-outline-primary me-2" %>
        <%= link_to "注册", new_registration_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </header>
</div>
