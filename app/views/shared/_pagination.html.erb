<% if @total_pages.to_i > 1 %>
  <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <span class="small text-body-secondary">第 <%= @page %> / <%= @total_pages %> 页，共 <%= @total %> 条</span>
    <span class="d-flex gap-2">
      <% if @page > 1 %>
        <%= link_to "上一页", url_for(request.query_parameters.symbolize_keys.merge(page: @page - 1)), class: "btn btn-sm btn-outline-secondary" %>
      <% end %>
      <% if @page < @total_pages %>
        <%= link_to "下一页", url_for(request.query_parameters.symbolize_keys.merge(page: @page + 1)), class: "btn btn-sm btn-outline-secondary" %>
      <% end %>
    </span>
  </nav>
<% end %>
