<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0"><%= @attempt.lesson ? "#{@attempt.lesson.title} · 测验结果" : "练习结果" %></h1>
  <div class="d-flex gap-2">
    <% if @attempt.lesson %>
      <%= link_to "返回课时", course_lesson_path(@course, @attempt.lesson), class: "btn btn-sm btn-outline-secondary" %>
      <%= link_to "再练一轮", course_practice_path(@course, lesson_id: @attempt.lesson_id), class: "btn btn-sm btn-primary" %>
    <% else %>
      <%= link_to "错题本", course_practice_mistakes_path(@course), class: "btn btn-sm btn-outline-secondary" %>
      <%= link_to "再练一轮", course_practice_path(@course), class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>
</div>

<p class="text-body-secondary">
  <%= @course.title %> · <%= @attempt.score %> / <%= @attempt.total %> · <%= @attempt.percent %>%
  · <%= @attempt.taken_at.strftime("%Y-%m-%d %H:%M") %>
</p>

<table class="table align-middle">
  <thead>
    <tr>
      <th>题目</th>
      <th>你的答案</th>
      <th>正确答案</th>
      <th>结果</th>
    </tr>
  </thead>
  <tbody>
    <% @answers.each do |answer| %>
      <tr class="<%= answer.correct? ? "" : "table-danger" %>">
        <td>
          <%= answer.question.stem %>
          <% if answer.question.explanation.present? %>
            <div class="small text-body-secondary"><%= answer.question.explanation %></div>
          <% end %>
        </td>
        <td><%= answer.response.presence || "—" %></td>
        <td><%= answer.question.answer %></td>
        <td><%= answer.correct? ? "对" : "错" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
