<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body p-4 p-md-5 text-center">
        <div class="text-body-secondary small mb-2">完成记录</div>
        <h1 class="h3 mb-4"><%= @certificate.course.title %></h1>
        <p class="mb-2"><%= @certificate.user.name %> 已完成本课程全部 <%= @certificate.course.lessons.count %> 个课时。</p>
        <p class="text-body-secondary small mb-4">签发日期 <%= @certificate.issued_at.strftime("%Y-%m-%d") %></p>
        <div class="border rounded p-3">
          <div class="text-body-secondary small">验证编号</div>
          <code><%= @certificate.serial %></code>
        </div>
      </div>
    </div>
  </div>
</div>
