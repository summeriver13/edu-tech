<div class="row justify-content-center">
  <div class="col-md-5">
    <h2 class="mb-4">注册</h2>

    <% if @user.errors.any? %>
      <div class="text-danger mb-3">
        <ul class="mb-0">
          <% @user.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: registration_path, scope: :user do |form| %>
      <div class="mb-3">
        <%= form.label :name, "用户名", class: "form-label" %>
        <%= form.text_field :name, class: "form-control", autofocus: true %>
      </div>

      <div class="mb-3">
        <%= form.label :password, "密码", class: "form-label" %>
        <%= form.password_field :password, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :password_confirmation, "确认密码", class: "form-label" %>
        <%= form.password_field :password_confirmation, class: "form-control" %>
      </div>

      <%= form.submit "注册", class: "btn btn-primary" %>
      <%= link_to "已有账号，去登录", new_session_path, class: "btn btn-link" %>
    <% end %>
  </div>
</div>
