<div class="p-4 p-md-5 mb-4 rounded text-body-emphasis bg-body-secondary">
  <div class="col-lg-6 px-0">
    <h1 class="display-4 fst-italic"><%= @course.title %></h1>
    <p class="lead my-3"><%= @course.description %></p>
    <p class="lead mb-0"><%= link_to "了解更多", information_course_path(@course), class: 'text-body-emphasis fw-bold' %></p>
  </div>
</div>

<% if @course.repo_url.present? %>
  <div class="card mb-4">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <div class="text-body-secondary small">课程仓库</div>
        <%= link_to @course.repo_url, @course.repo_url, class: "text-break" %>
        <div class="small text-body-secondary">
          <% if @course.commit_sha.present? %>
            已同步 <code><%= @course.commit_sha.first(7) %></code>
            <% if @course.synced_at %> · <%= @course.synced_at.strftime("%Y-%m-%d %H:%M") %><% end %>
          <% else %>
            尚未同步
          <% end %>
        </div>
      </div>
      <% if course_manager?(@course) %>
        <%= button_to "从仓库同步", sync_course_path(@course), method: :post, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="row g-4">
  <div class="col-md-6">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="h4 mb-0">资源</h2>
      <%= link_to "全部资源", course_resources_path(@course), class: "btn btn-sm btn-outline-secondary" %>
    </div>

    <% if @resources.any? %>
      <div class="list-group">
        <% @resources.each do |resource| %>
          <%= link_to course_resource_path(@course, resource), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
            <span>
              <%= resource.name %>
              <span class="badge text-bg-light"><%= resource.resource_type %></span>
            </span>
            <% if resource.video.present? %>
              <span class="badge text-bg-primary">视频</span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-body-secondary">暂无资源。</p>
    <% end %>
  </div>

  <div class="col-md-6">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="h4 mb-0">活动</h2>
      <%= link_to "全部活动", course_activities_path(@course), class: "btn btn-sm btn-outline-secondary" %>
    </div>

    <% if @activities.any? %>
      <div class="list-group">
        <% @activities.each do |activity| %>
          <%= link_to course_activity_path(@course, activity), class: "list-group-item list-group-item-action" do %>
            <div class="d-flex justify-content-between">
              <strong><%= activity.activity_type %></strong>
              <span class="small text-body-secondary"><%= activity.location %></span>
            </div>
            <div class="small text-body-secondary"><%= activity.start_time %></div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-body-secondary">暂无活动。</p>
    <% end %>
  </div>
</div>
