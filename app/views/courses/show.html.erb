<div class="p-4 p-md-5 mb-4 rounded text-body-emphasis bg-body-secondary">
  <div class="col-lg-6 px-0">
    <h1 class="display-4 fst-italic"><%= @course.title %></h1>
    <p class="lead my-3"><%= @course.description %></p>
    <p class="lead mb-0"><%= link_to "了解更多", information_course_path(@course), class: 'text-body-emphasis fw-bold' %></p>
    <p class="small text-body-secondary mt-2 mb-0">
      第 1 周 <%= @course.week1_start || "未设置" %> · <%= @course.time_zone %>
      <% if @course.current_week %> · 当前 W<%= @course.current_week %><% end %>
    </p>
  </div>
</div>

<% if @course.policies? %>
  <div class="card mb-4">
    <div class="card-body">
      <div class="fw-semibold mb-2">学期政策</div>
      <ul class="mb-0 small">
        <% if @course.census_at %><li>Census 日期 <%= @course.census_at %></li><% end %>
        <% if @course.min_attendance %><li>最低出勤率 <%= @course.min_attendance %>%</li><% end %>
        <% if @course.late_penalty_percent.to_f.positive? %>
          <li>
            迟交每天扣 <%= number_with_precision(@course.late_penalty_percent, precision: 0) %> 分<% if @course.late_penalty_max_days %>，超过 <%= @course.late_penalty_max_days %> 天不给分<% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>

<% if @course.repo_url.present? %>
  <div class="card mb-4">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <div class="text-body-secondary small">课程仓库</div>
        <%= link_to @course.repo_url, @course.repo_url, class: "text-break" %>
        <div class="small text-body-secondary">
          <% if @course.commit_sha.present? %>
            已同步 <code><%= @course.commit_sha.first(7) %></code>
            <% if @course.synced_at %> · <%= @course.synced_at.strftime("%Y-%m-%d %H:%M") %><% end %>
          <% else %>
            尚未同步
          <% end %>
        </div>
      </div>
      <% if course_manager?(@course) %>
        <%= button_to "从仓库同步", sync_course_path(@course), method: :post, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
<% end %>

<% if course_manager?(@course) %>
  <div class="d-flex gap-2 mb-4">
    <%= link_to "编辑课程", edit_course_path(@course), class: "btn btn-sm btn-outline-secondary" %>
    <%= link_to "成员管理", course_memberships_path(@course), class: "btn btn-sm btn-outline-secondary" %>
  </div>
<% end %>

<div class="row g-4">
  <div class="col-md-6">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="h4 mb-0">资源</h2>
      <%= link_to "全部资源", course_resources_path(@course), class: "btn btn-sm btn-outline-secondary" %>
    </div>

    <% if @resources.any? %>
      <div class="list-group">
        <% @resources.each do |resource| %>
          <%= link_to course_resource_path(@course, resource), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
            <span>
              <%= resource.name %>
              <span class="badge text-bg-light"><%= resource.resource_type %></span>
            </span>
            <% if resource.video.present? %>
              <span class="badge text-bg-primary">视频</span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-body-secondary">暂无资源。</p>
    <% end %>
  </div>

  <div class="col-md-6">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="h4 mb-0">活动</h2>
      <%= link_to "全部活动", course_activities_path(@course), class: "btn btn-sm btn-outline-secondary" %>
    </div>

    <% if @activities.any? %>
      <div class="list-group">
        <% @activities.each do |activity| %>
          <%= link_to course_activity_path(@course, activity), class: "list-group-item list-group-item-action" do %>
            <div class="d-flex justify-content-between">
              <strong><%= activity.activity_type %></strong>
              <span class="small text-body-secondary"><%= activity.location %></span>
            </div>
            <div class="small text-body-secondary">
              <% if activity.start_time %>[<%= week_label(@course, activity.start_time) %>] <%= @course.local_time(activity.start_time).strftime("%Y-%m-%d %H:%M") %><% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-body-secondary">暂无活动。</p>
    <% end %>
  </div>
</div>

<div class="mt-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">评估</h2>
    <%= link_to "全部评估", course_assessments_path(@course), class: "btn btn-sm btn-outline-secondary" %>
  </div>

  <% if @assessments.any? %>
    <div class="list-group">
      <% @assessments.each do |assessment| %>
        <%= link_to course_assessment_path(@course, assessment), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
          <span><%= assessment.title %></span>
          <span class="small text-body-secondary">
            <%= Assessment::KIND_LABELS.fetch(assessment.kind, assessment.kind) %>
            <%= number_to_percentage(assessment.weight, precision: 0) %>
            · <%= assessment.due_at ? "截止 #{assessment.due_at.strftime('%Y-%m-%d %H:%M')}" : "无截止时间" %>
          </span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-body-secondary">暂无评估项。</p>
  <% end %>
</div>

<% if course_member?(@course) %>
  <div class="mt-5">
    <h2 class="h4 mb-3">协作</h2>
    <div class="d-flex gap-2">
      <%= link_to "小组", course_groups_path(@course), class: "btn btn-outline-secondary" %>
      <%= link_to "贡献台账", course_contributions_path(@course), class: "btn btn-outline-secondary" %>
      <%= link_to "成绩", course_grades_path(@course), class: "btn btn-outline-secondary" %>
      <%= link_to "练习", course_practice_path(@course), class: "btn btn-outline-secondary" %>
      <%= link_to "错题本", course_practice_mistakes_path(@course), class: "btn btn-outline-secondary" %>
      <% if course_manager?(@course) %>
        <%= link_to "题库", course_questions_path(@course), class: "btn btn-outline-secondary" %>
      <% end %>
    </div>
  </div>
<% end %>
