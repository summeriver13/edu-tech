<div id="<%= dom_id course %>" class="container">

  <p>
    <label class="form-label">course_number:</label>
    <%= course.course_number %>
  </p>

  <p>
    <label class="form-label">Title:</label>
    <%= course.title %>
  </p>

  <p>
    <label class="form-label">Description:</label>
    <%= course.description %>
  </p>

  <% if course.cover.present? %>
    <p>
      <%= image_tag course.cover.url, alt: course.title, class: "img-fluid rounded mb-3" %>
    </p>
  <% end %>

  <p>
    <label class="form-label">Credit:</label>
    <%= course.credit %>
  </p>

</div>

