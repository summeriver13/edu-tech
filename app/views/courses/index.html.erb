<%= render "layouts/header" %>

<div class="container">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">课程</h1>
    <%= form_with url: courses_path, method: :get, class: "d-flex gap-2" do |form| %>
      <%= form.search_field :q, value: @query, placeholder: "搜索课程号、标题或简介", class: "form-control" %>
      <%= form.submit "搜索", class: "btn btn-outline-secondary" %>
    <% end %>
  </div>

  <% if @courses.empty? %>
    <p class="text-body-secondary">没有匹配的课程。</p>
  <% else %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
      <% @courses.each do |course| %>
        <div class="col">
          <div class="card h-100 shadow-sm">
            <% if course.cover.present? %>
              <%= image_tag course.cover.url, class: "card-img-top", alt: course.title %>
            <% end %>
            <div class="card-body">
              <h3 class="h5 card-title"><%= link_to course.title, course_path(course), class: "text-decoration-none" %></h3>
              <p class="card-text text-body-secondary"><%= truncate(strip_tags(course.description), length: 80) %></p>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center bg-transparent">
              <span class="badge text-bg-light"><%= course.course_number %></span>
              <span class="small text-body-secondary">Credit: <%= course.credit %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
    <span class="small text-body-secondary">第 <%= @page %> / <%= [@total_pages, 1].max %> 页，共 <%= @total %> 门课程</span>
    <span class="d-flex gap-2">
      <% if @page > 1 %>
        <%= link_to "上一页", courses_path(q: @query.presence, page: @page - 1), class: "btn btn-sm btn-outline-secondary" %>
      <% end %>
      <% if @page < @total_pages %>
        <%= link_to "下一页", courses_path(q: @query.presence, page: @page + 1), class: "btn btn-sm btn-outline-secondary" %>
      <% end %>
    </span>
  </nav>
</div>
