<div class="container">
  <h1>课程基本信息</h1>
  <%= render @course %>
</div>

<div class="container">
  <% if admin? %>
    <%= link_to "Edit course", edit_course_path(@course) %> |
  <% end %>
  <%= link_to "Back to course", course_path(@course) %>

  <% if admin? %>
    <%= button_to "Destroy this course", @course, method: :delete %>
  <% end %>
</div>
