<%= form_with(model: course) do |form| %>
  <% if course.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(course.errors.count, "error") %> prohibited this course from being saved:</h2>

      <ul>
        <% course.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :course_number, class: "form-label" %>
    <%= form.text_field :course_number, class: "form-control"%>
  </div>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control"%>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, rows:10, class: "form-control"%>
  </div>

  <div class="mb-3">
    <%= form.label :cover, class: "form-label" %>
    <%= form.file_field :cover, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :credit, class: "form-label" %>
    <%= form.text_field :credit, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :repo_url, "课程仓库地址", class: "form-label" %>
    <%= form.text_field :repo_url, class: "form-control" %>
    <div class="form-text">git 地址，例如 https://github.com/user/course-cs101.git。仓库根目录需有 course.yml。</div>
  </div>
  <br/>
  <div>
    <%= form.submit %>
  </div>
<% end %>
