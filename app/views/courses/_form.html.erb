<%= form_with(model: course) do |form| %>
  <% if course.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(course.errors.count, "error") %> prohibited this course from being saved:</h2>

      <ul>
        <% course.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :course_number, class: "form-label" %>
    <%= form.text_field :course_number, class: "form-control"%>
  </div>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control"%>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, rows:10, class: "form-control"%>
  </div>

  <div class="mb-3">
    <%= form.label :cover, class: "form-label" %>
    <%= form.file_field :cover, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :credit, class: "form-label" %>
    <%= form.text_field :credit, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :repo_url, "课程仓库地址", class: "form-label" %>
    <%= form.text_field :repo_url, class: "form-control" %>
    <div class="form-text">git 地址，例如 https://github.com/user/course-cs101.git。仓库根目录需有 course.yml。</div>
  </div>
  <div class="row g-3 mb-3">
    <div class="col-md-4">
      <%= form.label :week1_start, "第 1 周起始日", class: "form-label" %>
      <%= form.date_field :week1_start, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= form.label :time_zone, "时区", class: "form-label" %>
      <%= form.text_field :time_zone, class: "form-control" %>
      <div class="form-text">IANA 名称，例如 Asia/Shanghai。</div>
    </div>
    <div class="col-md-4">
      <%= form.label :term_weeks, "学期周数", class: "form-label" %>
      <%= form.number_field :term_weeks, min: 1, max: 52, class: "form-control" %>
    </div>
  </div>

  <div class="form-check mb-3">
    <%= form.check_box :self_enrollment, class: "form-check-input" %>
    <%= form.label :self_enrollment, "开放自选注册", class: "form-check-label" %>
    <div class="form-text">学习者可在课程页自行加入，加入后可标记课时完成。</div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-4">
      <%= form.label :census_at, "Census 日期", class: "form-label" %>
      <%= form.date_field :census_at, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= form.label :min_attendance, "最低出勤率（%）", class: "form-label" %>
      <%= form.number_field :min_attendance, min: 0, max: 100, class: "form-control" %>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-4">
      <%= form.label :late_penalty_percent, "迟交每天扣分", class: "form-label" %>
      <%= form.number_field :late_penalty_percent, min: 0, max: 100, step: 1, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= form.label :late_penalty_max_days, "迟交上限天数", class: "form-label" %>
      <%= form.number_field :late_penalty_max_days, min: 1, class: "form-control" %>
      <div class="form-text">超过该天数不给分；留空表示只按天扣。</div>
    </div>
  </div>

  <br/>
  <div>
    <%= form.submit %>
  </div>
<% end %>
