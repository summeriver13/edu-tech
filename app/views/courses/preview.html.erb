<h1 class="h3 mb-3">同步预览</h1>

<p class="text-body-secondary">
  仓库 <code><%= @course.repo_url %></code> · <%= @message %>
</p>

<% if @changes.any? %>
  <ul class="list-group mb-4">
    <% @changes.each do |change| %>
      <li class="list-group-item d-flex gap-2">
        <span class="badge text-bg-<%= change.action == "新增" ? "success" : "warning" %>"><%= change.action %></span>
        <span><%= change.text %></span>
      </li>
    <% end %>
  </ul>
  <p class="small text-body-secondary">同步只新增或更新，不删除平台内已有记录。</p>
  <%= button_to "确认同步", sync_course_path(@course), method: :post, class: "btn btn-primary" %>
<% else %>
  <p class="mb-4">没有变化，数据库已与仓库一致。</p>
<% end %>

<div class="mt-3">
  <%= link_to "返回课程", course_path(@course), class: "btn btn-link px-0" %>
</div>
