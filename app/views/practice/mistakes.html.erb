<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">错题本</h1>
  <div class="d-flex gap-2">
    <%= link_to "返回课程", course_path(@course), class: "btn btn-sm btn-outline-secondary" %>
    <%= link_to "继续练习", course_practice_path(@course), class: "btn btn-sm btn-primary" %>
  </div>
</div>

<p class="text-body-secondary"><%= @course.title %> · <%= @questions.size %> 题</p>

<% if @questions.any? %>
  <% @questions.each do |question| %>
    <div class="card mb-3">
      <div class="card-body">
        <div class="fw-semibold"><%= question.stem %></div>
        <div class="small text-body-secondary mb-2"><%= [ question.topic, question.slo, question.source ].compact_blank.join(" · ") %></div>
        <div><span class="badge text-bg-success">答案</span> <%= question.answer %></div>
        <% if question.explanation.present? %>
          <div class="small mt-2"><%= question.explanation %></div>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <p class="text-body-secondary">还没有错题。</p>
<% end %>
