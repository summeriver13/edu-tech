<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">练习</h1>
  <div class="d-flex gap-2">
    <%= link_to "返回课程", course_path(@course), class: "btn btn-sm btn-outline-secondary" %>
    <%= link_to "错题本", course_practice_mistakes_path(@course), class: "btn btn-sm btn-outline-secondary" %>
  </div>
</div>

<% if @questions.any? %>
  <%= form_with url: course_practice_path(@course), method: :post do |form| %>
    <% @questions.each_with_index do |question, index| %>
      <div class="mb-4">
        <div class="fw-semibold"><%= index + 1 %>. <%= question.stem %></div>
        <div class="small text-body-secondary mb-2"><%= [ question.topic, question.slo ].compact_blank.join(" · ") %></div>
        <%= hidden_field_tag "question_ids[]", question.id %>

        <% if question.kind == "short" %>
          <%= text_field_tag "responses[#{question.id}]", nil, class: "form-control" %>
        <% else %>
          <% question.choices.each_with_index do |choice, choice_index| %>
            <div class="form-check">
              <%= radio_button_tag "responses[#{question.id}]", choice, false, id: "q#{question.id}_#{choice_index}", class: "form-check-input" %>
              <%= label_tag "q#{question.id}_#{choice_index}", choice, class: "form-check-label" %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%= form.submit "提交", class: "btn btn-primary" %>
  <% end %>
<% else %>
  <p class="text-body-secondary">题库还是空的。</p>
<% end %>
