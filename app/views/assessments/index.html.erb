<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">评估</h1>
  <div class="d-flex gap-2">
    <%= link_to "返回课程", course_path(@course), class: "btn btn-sm btn-outline-secondary" %>
    <% if course_manager?(@course) %>
      <%= link_to "新建评估", new_course_assessment_path(@course), class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>
</div>

<p class="text-body-secondary"><%= @course.title %></p>

<% if @assessments.any? %>
  <% total = @assessments.sum(&:weight) %>
  <% unless total == 100 %>
    <div class="alert alert-warning">权重合计 <%= number_to_percentage(total, precision: 0) %>，应为 100%。</div>
  <% end %>

  <table class="table align-middle">
    <thead>
      <tr>
        <th>名称</th>
        <th>类型</th>
        <th class="text-end">权重</th>
        <th>截止</th>
        <th>范围</th>
      </tr>
    </thead>
    <tbody>
      <% @assessments.each do |assessment| %>
        <tr>
          <td><%= link_to assessment.title, course_assessment_path(@course, assessment) %></td>
          <td>
            <span class="badge text-bg-secondary"><%= Assessment::KIND_LABELS.fetch(assessment.kind, assessment.kind) %></span>
            <% if assessment.group_work %><span class="badge text-bg-info">小组</span><% end %>
          </td>
          <td class="text-end"><%= number_to_percentage(assessment.weight, precision: 0) %></td>
          <td><%= assessment.due_at ? assessment.due_at.strftime("%Y-%m-%d %H:%M") : "无" %></td>
          <td class="small text-body-secondary"><%= assessment.scope %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <th colspan="2">合计</th>
        <th class="text-end"><%= number_to_percentage(total, precision: 0) %></th>
        <th colspan="2"></th>
      </tr>
    </tfoot>
  </table>
<% else %>
  <p class="text-body-secondary">还没有评估项。</p>
<% end %>
