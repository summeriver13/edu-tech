<%= form_with(model: [course, assessment]) do |form| %>
  <% if assessment.errors.any? %>
    <div class="text-danger mb-3">
      <ul class="mb-0">
        <% assessment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :kind, "类型", class: "form-label" %>
    <%= form.select :kind, Assessment::KIND_LABELS.map { |key, label| [ label, key ] }, {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :weight, "权重（%）", class: "form-label" %>
    <%= form.number_field :weight, min: 0, max: 100, step: 1, class: "form-control" %>
  </div>

  <div class="mb-3 form-check">
    <%= form.check_box :group_work, class: "form-check-input" %>
    <%= form.label :group_work, "小组作业", class: "form-check-label" %>
  </div>

  <div class="mb-3 form-check">
    <%= form.check_box :hurdle, class: "form-check-input" %>
    <%= form.label :hurdle, "通过门槛", class: "form-check-label" %>
    <div class="form-text">未达标时总评记 TF。不填最低分表示只需提交。</div>
  </div>

  <div class="mb-3">
    <%= form.label :min_score, "门槛最低分（%）", class: "form-label" %>
    <%= form.number_field :min_score, min: 0, max: 100, step: 1, class: "form-control" %>
  </div>

  <div class="mb-3 form-check">
    <%= form.check_box :pass_fail, class: "form-check-input" %>
    <%= form.label :pass_fail, "及格制（只记通过 / 未通过）", class: "form-check-label" %>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= form.label :sittings, "计划次数（测验用）", class: "form-label" %>
      <%= form.number_field :sittings, min: 1, class: "form-control" %>
    </div>
    <div class="col-md-6">
      <%= form.label :best_of, "取最好几次", class: "form-label" %>
      <%= form.number_field :best_of, min: 1, class: "form-control" %>
      <div class="form-text">留空表示全部计分。</div>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :ai_policy, "AI 使用政策", class: "form-label" %>
    <%= form.select :ai_policy, Assessment::AI_POLICY_LABELS.map { |key, label| [ label, key ] }, { include_blank: "未规定" }, class: "form-select" %>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-4">
      <%= form.label :word_limit, "字数要求（词）", class: "form-label" %>
      <%= form.number_field :word_limit, min: 1, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= form.label :word_limit_tolerance, "允许偏差（%）", class: "form-label" %>
      <%= form.number_field :word_limit_tolerance, min: 0, class: "form-control" %>
    </div>
    <div class="col-md-4"></div>
    <div class="col-md-4">
      <%= form.label :group_min, "小组最少人数", class: "form-label" %>
      <%= form.number_field :group_min, min: 1, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= form.label :group_max, "小组最多人数", class: "form-label" %>
      <%= form.number_field :group_max, min: 1, class: "form-control" %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :scope, "考核范围", class: "form-label" %>
    <%= form.text_field :scope, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, rows: 5, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :due_at, "截止时间", class: "form-label" %>
    <%= form.datetime_local_field :due_at, class: "form-control" %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
<% end %>
