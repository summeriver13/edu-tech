<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0"><%= @assessment.title %></h1>
  <div class="d-flex gap-2">
    <%= link_to "返回课程", course_path(@course), class: "btn btn-sm btn-outline-secondary" %>
    <% if course_manager?(@course) %>
      <%= link_to "编辑", edit_course_assessment_path(@course, @assessment), class: "btn btn-sm btn-outline-secondary" %>
      <%= button_to "删除", course_assessment_path(@course, @assessment), method: :delete, class: "btn btn-sm btn-outline-danger", form_class: "d-inline", data: { turbo_confirm: "确认删除？" } %>
    <% end %>
  </div>
</div>

<p class="text-body-secondary">
  <%= @course.title %> ·
  <span class="badge text-bg-secondary"><%= Assessment::KIND_LABELS.fetch(@assessment.kind, @assessment.kind) %></span>
  <%= number_to_percentage(@assessment.weight, precision: 0) %>
  <% if @assessment.group_work %><span class="badge text-bg-info">小组</span><% end %>
  <% if @assessment.hurdle %>
    <span class="badge text-bg-warning">门槛 <%= @assessment.min_score ? "≥#{number_with_precision(@assessment.min_score, precision: 0)}%" : "须提交" %></span>
  <% end %>
  <% if @assessment.pass_fail %><span class="badge text-bg-dark">及格制</span><% end %>
  <% if @assessment.due_at %> · 截止 <%= [ week_label(@course, @assessment.due_at), @course.local_time(@assessment.due_at).strftime("%Y-%m-%d %H:%M") ].compact.join(" ") %><% end %>
  <% if @assessment.scope.present? %> · 范围 <%= @assessment.scope %><% end %>
</p>

<p class="lead"><%= simple_format(@assessment.description) %></p>

<% if @submissions %>
  <h2 class="h5 mt-4">提交（<%= @submissions.size %>）</h2>
  <% if @submissions.any? %>
    <table class="table align-middle">
      <thead>
        <tr>
          <th>学生</th>
          <th>内容</th>
          <th>附件</th>
          <th>时间</th>
          <th>成绩</th>
        </tr>
      </thead>
      <tbody>
        <% @submissions.each do |submission| %>
          <tr>
            <td>
              <%= submission.user.name %>
              <% if submission.group %><span class="small text-body-secondary"><%= submission.group.name %></span><% end %>
            </td>
            <td><%= truncate(submission.body.to_s, length: 80) %></td>
            <td>
              <% if submission.file.present? %>
                <%= link_to "下载", submission.file.url, target: "_blank", rel: "noopener" %>
              <% end %>
            </td>
            <td class="small text-body-secondary"><%= submission.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td>
              <%= form_with url: course_assessment_submission_grade_path(@course, @assessment, submission), method: :patch, scope: :grade, class: "d-flex gap-1" do |form| %>
                <%= form.number_field :score, value: submission.grade&.score, min: 0, max: 100, step: 1, class: "form-control form-control-sm", style: "width: 5rem" %>
                <%= form.submit "保存", class: "btn btn-sm btn-outline-primary" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-body-secondary">还没有人提交。</p>
  <% end %>
<% elsif @submission %>
  <h2 class="h5 mt-4"><%= @submission.persisted? ? "我的提交" : "提交作业" %></h2>

  <% if @submission.errors.any? %>
    <div class="text-danger mb-3">
      <ul class="mb-0">
        <% @submission.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: @submission, url: course_assessment_submission_path(@course, @assessment), method: @submission.persisted? ? :patch : :post) do |form| %>
    <div class="mb-3">
      <%= form.label :body, "内容", class: "form-label" %>
      <%= form.text_area :body, rows: 5, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :file, "附件", class: "form-label" %>
      <%= form.file_field :file, class: "form-control" %>
      <div class="form-text">支持 pdf / zip / txt / md / docx / pptx / png / jpg，单个文件不超过 50 MB。</div>
    </div>

    <%= form.submit(@submission.persisted? ? "更新提交" : "提交", class: "btn btn-primary") %>
  <% end %>

  <% if @submission.persisted? %>
    <p class="small text-body-secondary mt-2">提交时间 <%= @submission.created_at.strftime("%Y-%m-%d %H:%M") %></p>
    <% if @assessment.pass_fail? && @assessment.outcome_for(current_user) %>
      <p class="small">结果：<strong><%= @assessment.outcome_for(current_user) %></strong></p>
    <% end %>
  <% end %>
<% else %>
  <p class="text-body-secondary"><%= link_to "登录", new_session_path %> 后可提交作业。</p>
<% end %>
