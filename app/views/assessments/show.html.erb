<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0"><%= @assessment.title %></h1>
  <div class="d-flex gap-2">
    <%= link_to "返回课程", course_path(@course), class: "btn btn-sm btn-outline-secondary" %>
    <% if course_manager?(@course) %>
      <%= link_to "编辑", edit_course_assessment_path(@course, @assessment), class: "btn btn-sm btn-outline-secondary" %>
      <%= button_to "删除", course_assessment_path(@course, @assessment), method: :delete, class: "btn btn-sm btn-outline-danger", form_class: "d-inline", data: { turbo_confirm: "确认删除？" } %>
    <% end %>
  </div>
</div>

<p class="text-body-secondary">
  <%= @course.title %> ·
  <span class="badge text-bg-secondary"><%= Assessment::KIND_LABELS.fetch(@assessment.kind, @assessment.kind) %></span>
  <%= number_to_percentage(@assessment.weight, precision: 0) %>
  <% if @assessment.group_work %><span class="badge text-bg-info">小组</span><% end %>
  <% if @assessment.hurdle %>
    <span class="badge text-bg-warning">门槛 <%= @assessment.min_score ? "≥#{number_with_precision(@assessment.min_score, precision: 0)}%" : "须提交" %></span>
  <% end %>
  <% if @assessment.pass_fail %><span class="badge text-bg-dark">及格制</span><% end %>
  <% if @assessment.best_of %>
    <span class="badge text-bg-primary"><%= @assessment.sittings ? "#{@assessment.sittings} 次取 #{@assessment.best_of}" : "取最好 #{@assessment.best_of} 次" %></span>
  <% end %>
  <% if @assessment.ai_policy %>
    <span class="badge text-bg-danger"><%= Assessment::AI_POLICY_LABELS.fetch(@assessment.ai_policy, @assessment.ai_policy) %></span>
  <% end %>
  <% if @assessment.due_at %> · 截止 <%= [ week_label(@course, @assessment.due_at), @course.local_time(@assessment.due_at).strftime("%Y-%m-%d %H:%M") ].compact.join(" ") %><% end %>
  <% if @assessment.scope.present? %> · 范围 <%= @assessment.scope %><% end %>
  <% if @assessment.word_range %> · 字数 <%= @assessment.word_range.join("–") %><% end %>
  <% if @assessment.group_min || @assessment.group_max %> · 小组 <%= [ @assessment.group_min, @assessment.group_max ].compact.join("–") %> 人<% end %>
</p>

<p class="lead"><%= simple_format(@assessment.description) %></p>

<% if @assessment.deliverables.any? %>
  <div class="mb-4">
    <div class="fw-semibold">交付物</div>
    <ul class="mb-0">
      <% @assessment.deliverables.each do |deliverable| %>
        <li>
          <%= deliverable.name %>
          <% if deliverable.due_at %>
            · 截止 <%= [ week_label(@course, deliverable.due_at), @course.local_time(deliverable.due_at).strftime("%Y-%m-%d %H:%M") ].compact.join(" ") %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if @course.late_penalty_percent.to_f.positive? %>
  <p class="small text-body-secondary">
    迟交每天扣 <%= number_with_precision(@course.late_penalty_percent, precision: 0) %> 分<% if @course.late_penalty_max_days %>，超过 <%= @course.late_penalty_max_days %> 天不给分<% end %>。
  </p>
<% end %>

<% if @assessment.kind == "quiz" %>
  <div class="card mb-4">
    <div class="card-body">
      <div class="text-body-secondary small">测验</div>
      <div>
        计划 <%= @assessment.sittings || "不限" %> 次，计分取最好 <%= @assessment.best_of || "全部" %> 次。
      </div>
      <% if current_user && course_member?(@course) %>
        <% taken = @assessment.attempts.where(user_id: current_user.id).count %>
        <% score = @assessment.attempt_score_for(current_user) %>
        <div class="mt-2">已做 <%= taken %> 次<% if score %>，当前计分 <%= score %><% end %></div>
        <%= link_to "开始测验", course_practice_path(@course, assessment_id: @assessment.id), class: "btn btn-sm btn-primary mt-2" %>
      <% end %>
    </div>
  </div>
<% elsif @submissions %>
  <h2 class="h5 mt-4">提交（<%= @submissions.size %>）</h2>
  <% if @submissions.any? %>
    <table class="table align-middle">
      <thead>
        <tr>
          <th>学生</th>
          <th>交付物</th>
          <th>内容</th>
          <th>附件</th>
          <th>时间</th>
          <th>成绩</th>
        </tr>
      </thead>
      <tbody>
        <% @submissions.each do |submission| %>
          <tr>
            <td>
              <%= submission.user.name %>
              <% if submission.group %><span class="small text-body-secondary"><%= submission.group.name %></span><% end %>
            </td>
            <td class="small text-body-secondary"><%= submission.deliverable&.name || "—" %></td>
            <td><%= truncate(submission.body.to_s, length: 80) %></td>
            <td>
              <% if submission.file.present? %>
                <%= link_to "下载", submission.file.url, target: "_blank", rel: "noopener" %>
              <% end %>
            </td>
            <td class="small text-body-secondary"><%= submission.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td>
              <%= form_with url: course_assessment_submission_grade_path(@course, @assessment, submission), method: :patch, scope: :grade, class: "d-flex gap-1" do |form| %>
                <%= form.number_field :score, value: submission.grade&.score, min: 0, max: 100, step: 1, class: "form-control form-control-sm", style: "width: 5rem" %>
                <%= form.submit "保存", class: "btn btn-sm btn-outline-primary" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-body-secondary">还没有人提交。</p>
  <% end %>
<% elsif logged_in? %>
  <h2 class="h5 mt-4">提交</h2>

  <% @slot_rows.each do |deliverable, submission| %>
    <div class="card mb-3">
      <div class="card-body">
        <div class="fw-semibold mb-2">
          <%= deliverable ? deliverable.name : "提交内容" %>
          <% if deliverable&.due_at %>
            · 截止 <%= [ week_label(@course, deliverable.due_at), @course.local_time(deliverable.due_at).strftime("%Y-%m-%d %H:%M") ].compact.join(" ") %>
          <% end %>
          <% if submission.persisted? %><span class="badge text-bg-success">已提交</span><% end %>
        </div>

        <% if submission.errors.any? %>
          <div class="text-danger small mb-2">
            <ul class="mb-0">
              <% submission.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if submission.persisted? %>
          <div class="border rounded p-2 my-2 small"><%= simple_format(submission.body) if submission.body.present? %>
            <% if submission.file.present? %><%= link_to "下载附件", submission.file.url, target: "_blank", rel: "noopener" %><% end %>
          </div>
          <div class="small text-body-secondary mb-2">
            提交时间 <%= submission.created_at.strftime("%Y-%m-%d %H:%M") %>
            <% if submission.late_days.positive? %> · 迟交 <%= submission.late_days %> 天<% end %>
          </div>
        <% end %>

        <%= form_with(model: submission, url: submission.persisted? ? course_assessment_submission_path(@course, @assessment, submission) : course_assessment_submissions_path(@course, @assessment), method: submission.persisted? ? :patch : :post) do |form| %>
          <%= form.hidden_field :deliverable_id, value: deliverable&.id %>
          <div class="mb-2">
            <%= form.text_area :body, rows: 4, class: "form-control", placeholder: "内容" %>
            <% if submission.body.present? %>
              <div class="form-text">当前 <%= submission.word_count %> 词。</div>
            <% end %>
          </div>

          <div class="mb-2">
            <%= form.file_field :file, class: "form-control" %>
            <div class="form-text">支持 pdf / zip / txt / md / docx / pptx / png / jpg，单个文件不超过 50 MB。</div>
          </div>

          <%= form.submit(submission.persisted? ? "更新提交" : "提交", class: "btn btn-sm btn-primary") %>
        <% end %>

        <% if submission.persisted? && @assessment.pass_fail? && @assessment.outcome_for(current_user) %>
          <p class="small mt-2 mb-0">结果：<strong><%= @assessment.outcome_for(current_user) %></strong></p>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <p class="text-body-secondary"><%= link_to "登录", new_session_path %> 后可提交作业。</p>
<% end %>
