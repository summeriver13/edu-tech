<div class="row justify-content-center">
  <div class="col-md-5">
    <h2 class="mb-4">登录</h2>

    <% if flash.now[:alert] %>
      <div class="alert alert-danger"><%= flash.now[:alert] %></div>
    <% end %>

    <%= form_with url: session_path, method: :post do |form| %>
      <div class="mb-3">
        <%= form.label :name, "用户名", class: "form-label" %>
        <%= form.text_field :name, class: "form-control", autofocus: true %>
      </div>

      <div class="mb-3">
        <%= form.label :password, "密码", class: "form-label" %>
        <%= form.password_field :password, class: "form-control" %>
      </div>

      <%= form.submit "登录", class: "btn btn-primary" %>
      <%= link_to "没有账号？去注册", new_registration_path, class: "btn btn-link" %>
    <% end %>
  </div>
</div>
