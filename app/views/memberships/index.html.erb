<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">课程成员</h1>
  <%= link_to "返回课程", course_path(@course), class: "btn btn-sm btn-outline-secondary" %>
</div>

<p class="text-body-secondary"><%= @course.title %></p>

<% if @membership.errors.any? %>
  <div class="text-danger mb-3">
    <ul class="mb-0">
      <% @membership.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with url: course_memberships_path(@course), method: :post, class: "row g-2 align-items-end mb-4" do |form| %>
  <div class="col-sm-5">
    <%= label_tag :user_name, "用户名", class: "form-label" %>
    <%= text_field_tag :user_name, params[:user_name], class: "form-control" %>
  </div>
  <div class="col-sm-4">
    <%= label_tag :role, "角色", class: "form-label" %>
    <%= select_tag :role, options_for_select(CourseMembership::ROLES, params[:role]), class: "form-select" %>
  </div>
  <div class="col-sm-3">
    <%= form.submit "加入课程", class: "btn btn-primary w-100" %>
  </div>
<% end %>

<% if @memberships.any? %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>用户名</th>
        <th>角色</th>
        <th class="text-end">操作</th>
      </tr>
    </thead>
    <tbody>
      <% @memberships.each do |membership| %>
        <tr>
          <td><%= membership.user.name %></td>
          <td><%= membership.role %></td>
          <td class="text-end">
            <%= button_to "移除", course_membership_path(@course, membership), method: :delete, class: "btn btn-sm btn-outline-danger", form_class: "d-inline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-body-secondary">还没有成员。</p>
<% end %>
