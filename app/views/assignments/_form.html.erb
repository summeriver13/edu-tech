<%= form_with(model: [course, assignment]) do |form| %>
  <% if assignment.errors.any? %>
    <div class="text-danger mb-3">
      <ul class="mb-0">
        <% assignment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, rows: 5, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :due_at, "截止时间", class: "form-label" %>
    <%= form.datetime_local_field :due_at, class: "form-control" %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
<% end %>
