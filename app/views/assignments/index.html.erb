<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">作业</h1>
  <div class="d-flex gap-2">
    <%= link_to "返回课程", course_path(@course), class: "btn btn-sm btn-outline-secondary" %>
    <% if course_manager?(@course) %>
      <%= link_to "新建作业", new_course_assignment_path(@course), class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>
</div>

<p class="text-body-secondary"><%= @course.title %></p>

<% if @assignments.any? %>
  <div class="list-group">
    <% @assignments.each do |assignment| %>
      <%= link_to course_assignment_path(@course, assignment), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
        <span><%= assignment.title %></span>
        <span class="small text-body-secondary">
          <%= assignment.due_at ? "截止 #{assignment.due_at.strftime('%Y-%m-%d %H:%M')}" : "无截止时间" %>
        </span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="text-body-secondary">还没有作业。</p>
<% end %>
