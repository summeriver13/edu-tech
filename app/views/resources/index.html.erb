<h2><%= @course.title %> 资源</h2>

<div class="table-responsive">
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Type</th>
        <th>Url</th>
        <th>Video</th>
      </tr>
    </thead>
    <tbody>
      <% @resources.each do |resource| %>
        <tr>
          <td><%= link_to resource.name, course_resource_path(@course, resource) %></td>
          <td><%= resource.resource_type %></td>
          <td><%= resource.url %></td>
          <td><%= resource.video.url if resource.video.present? %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if admin? %>
  <%= link_to "New resource", new_course_resource_path(@course), class: "btn btn-primary" %>
<% end %>
<%= link_to "Back to course", course_path(@course), class: "btn btn-outline-secondary" %>
