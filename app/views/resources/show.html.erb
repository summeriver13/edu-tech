<h2><%= @resource.name %></h2>

<p>
  <strong>Type:</strong>
  <%= @resource.resource_type %>
</p>

<p>
  <strong>Url:</strong>
  <%= @resource.url %>
</p>

<p>
  <strong>Description:</strong>
  <%= @resource.description %>
</p>

<% if @resource.video.present? %>
  <video controls preload="metadata" class="w-100 rounded mb-3" src="<%= @resource.video.url %>"></video>
  <p>
    <%= link_to "下载视频", @resource.video.url, target: "_blank", rel: "noopener" %>
  </p>
<% end %>

<% if admin? %>
  <%= link_to "Edit", edit_course_resource_path(@course, @resource), class: "btn btn-outline-secondary" %>
<% end %>
<%= link_to "Back to resources", course_resources_path(@course), class: "btn btn-outline-secondary" %>
